# FoxOnAShelf™ - Variables de entorno (ejemplo)
# Copia este archivo como .env en la raíz del repo (BookShelf/.env) y ajusta valores.

# ----------- Base de datos -----------
# Si DATABASE_URL está definido, DB_MODE=postgres por defecto.
DATABASE_URL=postgres://bookshelf:bookshelf@localhost:5432/bookshelf_db
DB_MODE=json
# DB_MODE=postgres  (descomenta para usar Postgres)
# DB_MODE=json      (modo demo sin instalar Postgres - usa backend/storage/db.json)

# ----------- JWT -----------
JWT_SECRET=cambia-esta-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=7d

# ----------- Supabase (opcional) -----------
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_KEY=your-anon-or-service-key

# ----------- Almacenamiento local (si no usas Supabase) -----------
STORAGE_PATH=./backend/storage

# ----------- App -----------
PORT=4000
FRONTEND_URL=http://localhost:3100

# ----------- Límites -----------
MAX_UPLOAD_SIZE_BYTES=5242880    # 5 MB
